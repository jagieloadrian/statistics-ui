root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
ktlint_code_style = ktlint_official
ktlint_function_naming_ignore_when_annotated_with = Composable

[**/main.kt]
ktlint_standard_filename = disabled

[**/build/generated/**]
ktlint_standard = disabled
